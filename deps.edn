;; Root deps.edn — hermetic entry point.
;; The assemblage repo is its own environment: tests run from the repo root
;; so that the verbatim register gate (assemblages/wisdom-1951/primary/)
;; resolves relative to the primary corpus itself.
{:aliases
 {:test {:extra-paths ["clojure/src" "clojure/test"]
         :extra-deps {org.clojure/clojure {:mvn/version "1.12.0"}
                      org.clojure/spec.alpha {:mvn/version "0.5.238"}
                      io.github.nextjournal/markdown {:git/tag "v0.7.232"
                                                      :git/sha "1580eeb11773902b943f4acf88d9f8e1a4ea9e67"}
                      org.clojure/test.check {:mvn/version "1.1.1"}}
         :main-opts ["-m" "cognitect.test-runner"]}}}
